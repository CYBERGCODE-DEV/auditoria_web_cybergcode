# Opcional. Recomendado para uso frecuente de PageSpeed Insights.
PAGESPEED_API_KEY=

# Solo desarrollo local si Chrome/Chromium no está en una ruta estándar.
CHROME_EXECUTABLE_PATH=

# Opcional. Chromium empaquetado es la ruta principal; define una URL solo como fallback explícito compatible.
CHROMIUM_PACK_URL=
CRUX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Protección del scanner y exportación PDF. Usa valores largos, aleatorios y diferentes.
CYBERGCODE_AUDIT_KEY=
CYBERGCODE_RATE_LIMIT=30
CYBERGCODE_REPORT_SECRET=

# Debe permanecer en 0 en producción salvo que se acepte persistencia pública deliberadamente.
CYBERGCODE_ALLOW_ANONYMOUS_PERSISTENCE=0

# Las auditorías >50 páginas se procesan en lotes desde el navegador.

# ============================================================
# V0.15.1 — BASE DE DATOS MULTIPROVEEDOR
# ============================================================
# Recomendado para tu caso: MySQL/MariaDB.
# Valores aceptados: mysql | mariadb | tidb | planetscale | postgres | neon
DB_PROVIDER=mysql

# MySQL 8 / MariaDB / TiDB:
# DATABASE_URL=mysql://usuario:password@host:3306/cybergcode
# También se acepta mariadb:// y se normaliza internamente.
DATABASE_URL=
# Alias opcionales si tu proveedor los entrega con otro nombre:
MYSQL_URL=
MARIADB_URL=
POSTGRES_URL=

# Pool pequeño para Functions serverless. Rango permitido por el motor: 1-12.
DB_POOL_LIMIT=4
DB_CONNECT_TIMEOUT_MS=10000

# Actívalo si tu proveedor exige TLS. TiDB Cloud lo activa automáticamente por hostname.
DB_SSL=0
DB_SSL_REJECT_UNAUTHORIZED=1

# Alternativa PostgreSQL/Neon:
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Clave administrativa temporal para Proyectos, Histórico y Comparativas.
# No se incrusta en frontend; la interfaz la conserva en sessionStorage.
CYBERGCODE_PLATFORM_KEY=
