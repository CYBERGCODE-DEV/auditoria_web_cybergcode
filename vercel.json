{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/audit.js": {
      "maxDuration": 300
    },
    "api/report.js": {
      "maxDuration": 60
    },
    "api/identity.js": {
      "maxDuration": 30
    },
    "api/jobs/start.js": {
      "maxDuration": 60
    },
    "api/jobs/process.js": {
      "maxDuration": 120
    },
    "api/jobs/finalize.js": {
      "maxDuration": 300
    },
    "api/jobs/status.js": {
      "maxDuration": 30
    },
    "api/jobs/result.js": {
      "maxDuration": 60
    },
    "api/jobs/page.js": {
      "maxDuration": 60
    },
    "api/jobs/cancel.js": {
      "maxDuration": 30
    },
    "api/queues/large-audit.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "cybergcode-large-audit",
          "retryAfterSeconds": 45,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/platform-status.js": {
      "maxDuration": 30
    },
    "api/projects.js": {
      "maxDuration": 30
    },
    "api/project.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/audit-record.js": {
      "maxDuration": 60
    },
    "api/comparison.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    }
  ],
  "regions": [
    "iad1"
  ]
}
